# androbuilder — environment variable overrides (highest precedence before CLI flags).
# Copy to `.env` if you prefer env-based config, or use these in CI.
# All are optional; unset values fall back to project/global config.

# AWS
ANDROBUBILDER_REGION=us-east-1
ANDROBUBILDER_PROFILE=default

# Compute
ANDROBUBILDER_AMI_ID=ami-xxxxxxxxxxxxxxxxx
ANDROBUBILDER_SUBNET_ID=subnet-xxxxxxxxxxxxxxxxx
ANDROBUBILDER_KEY_NAME=androbuilder
ANDROBUBILDER_SECURITY_GROUP=androbuilder
ANDROBUBILDER_INSTANCE_PROFILE=androbuilder-s3
ANDROBUBILDER_INSTANCE_TAG=my-app-builder
ANDROBUBILDER_INSTANCE_TYPES=c7i.2xlarge,c8i.2xlarge,c6i.2xlarge

# Storage / cache
ANDROBUBILDER_S3_BUCKET=my-app-builds
ANDROBUBILDER_CACHE_VOLUME_NAME=my-app-cache
ANDROBUBILDER_CACHE_VOLUME_SIZE=30

# Project
ANDROBUBILDER_REPO_NAME=my-app
ANDROBUBILDER_PACKAGE_NAME=com.example.myapp

# Signing (secrets)
ANDROBUBILDER_KEYSTORE=release.keystore
ANDROBUBILDER_KEYSTORE_ALIAS=my-alias
ANDROBUBILDER_KEYSTORE_PASSWORD=
ANDROBUBILDER_KEYSTORE_KEY_PASSWORD=

# Deploy
ANDROBUBILDER_FASTLANE_KEY=fastlane/play-store-key.json
